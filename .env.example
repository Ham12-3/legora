# ---------------------------------------------------------------------------
# Copy to .env. Never commit .env.
# OPENAI_API_KEY lives ONLY on the FastAPI side. It must never appear in the
# web app, and never under a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# --- api ---
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://legora:legora@localhost:5432/legora
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=legora
S3_SECRET_ACCESS_KEY=legora-secret
S3_BUCKET=legora-documents
S3_REGION=us-east-1
# The browser uploads via presigned URLs; SigV4 signs the host, so this must be
# an address the browser can reach.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# Shared by the Next.js SERVER and the API. Signs the internal JWT and gates
# /auth/*. Generate with: openssl rand -base64 32
INTERNAL_API_SECRET=dev-internal-secret-change-me-at-least-32-bytes

# --- openai ---
# Model ids move faster than this code. They are keyed by ROLE, never inlined.
# Verify these against the current lineup before a real run.
OPENAI_API_KEY=
MODEL_ROUTER=gpt-5-nano
MODEL_EXTRACT=gpt-5-mini
MODEL_SYNTH=gpt-5

# Embeddings. EMBED_DIM is baked into the pgvector column type: changing it
# means re-embedding every chunk in the database. See CLAUDE.md.
EMBED_MODEL=text-embedding-3-large
EMBED_DIM=1536

# Bumping this invalidates the cell cache.
PROMPT_VERSION=v1

# --- web ---
# Next.js reads apps/web/.env.local, not this file. When running the web app
# outside docker: cp .env apps/web/.env.local
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Auth.js session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET=dev-auth-secret-change-me-at-least-32-bytes-long
